# Never commit secrets. Copy to .env.local.
JARVISLABS_API_KEY=
# Copy the EXACT model ID from your signed-in Jarvislabs model catalog, do not guess.
JARVISLABS_MODEL=
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
# Off by default so the direct demonstration works before Temporal is running.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
